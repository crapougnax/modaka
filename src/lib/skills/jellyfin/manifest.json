{
  "$schema": "https://schema.quatrain.dev/v1/package-interchange.json",
  "extends": "package.json",
  "id": "@quatrain/skills-jellyfin",
  "icon": "🎵",
  "category": "media",
  "fields": [
    {
      "name": "url",
      "label": "Jellyfin Server URL",
      "type": "text",
      "placeholder": "http://localhost:8096",
      "default": "http://localhost:8096",
      "required": true
    },
    {
      "name": "apiKey",
      "label": "Jellyfin API Key (Direct Auth)",
      "type": "password",
      "placeholder": "Enter your Jellyfin API Key (Recommended)...",
      "required": false
    },
    {
      "name": "username",
      "label": "Jellyfin Username",
      "type": "text",
      "placeholder": "Jellyfin account username...",
      "required": false
    },
    {
      "name": "password",
      "label": "Jellyfin Password",
      "type": "password",
      "placeholder": "Password...",
      "required": false
    },
    {
      "name": "libraryName",
      "label": "Target Media Library Name",
      "type": "text",
      "placeholder": "Music, Audio, ...",
      "description": "Optional filter to restrict queries to a specific library.",
      "required": false
    }
  ]
}
