# ==============================================================================
# Modaka Workspace Environment Variables Template (.env.dist)
# ==============================================================================

NODE_ENV=development
USER_NAME=your_username
USER_EMAIL=

# Knowledge base and document storage paths
GIT_LOCAL_PATH=/path/to/second-brain-data
DOCUMENT_STORAGE_PATH=/path/to/second-brain-documents
MODAKA_CONFIG_PATH=/path/to/.queue/user_config.json
QUEUE_STORAGE_DIR=/path/to/.queue
COLLECTION_NAME=modaka-knowledge

# AI & LLM configuration
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.5-flash

# Git local-first configuration
GIT_MODE=local
GIT_AUTO_SYNC=false
GIT_REPO_OWNER=your_github_login
GIT_REPO_NAME=second-brain-data
GIT_BRANCH=main
GIT_GITHUB_TOKEN=

# S3 Blob Storage configuration (Optional)
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
# S3_BUCKET=second-brain
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# GitHub OAuth integration (Optional)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
